# Copy to .env and fill in local values. Do not commit real secrets.
AE_RAG_DB_HOST=localhost
AE_RAG_DB_PORT=3306
AE_RAG_DB_USER=root
AE_RAG_DB_PASSWORD=
AE_RAG_DB_NAME=adaptive_enterprise_rag

# Research ChromaDB remains frozen for experiments.
AE_RAG_CHROMA_PATH=./chroma_db

# Final application ChromaDB contains only HR-uploaded documents.
AE_RAG_APP_CHROMA_PATH=./data/application_chroma_db
AE_RAG_APP_COLLECTION=application_uploaded_documents

AE_RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
AE_RAG_GENERATION_MODEL=qwen3:8b
AE_RAG_OLLAMA_URL=http://localhost:11434
AE_RAG_UPLOAD_ROOT=./data/uploads
AE_RAG_HISTORY_ROOT=./data/query_history
AE_RAG_HOST=127.0.0.1
AE_RAG_PORT=8000
